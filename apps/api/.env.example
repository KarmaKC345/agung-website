# Koneksi Postgres. Di Supabase: Project Settings → Database → Connection string
# (pakai "Session pooler" untuk server yang selalu menyala).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/newagung

PORT=4000
# Domain web yang boleh memanggil API (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:3000
# URL publik API ini (dipakai untuk URL foto bila tidak memakai Supabase Storage)
PUBLIC_API_URL=http://localhost:4000

# Supabase (Auth + Storage). Kosongkan untuk mode lokal tanpa Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Opsional: hanya untuk project lama yang masih memakai JWT secret (HS256).
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=products
# Email pemilik. Saat tabel staff masih kosong, akun dengan email ini otomatis jadi owner.
OWNER_EMAIL=

# Revalidasi halaman Next.js setelah data berubah
WEB_URL=http://localhost:3000
REVALIDATE_SECRET=ganti-dengan-string-acak

# HANYA untuk pengembangan lokal: token ini diterima sebagai login owner.
# Diabaikan otomatis saat NODE_ENV=production.
DEV_AUTH_TOKEN=dev-owner
