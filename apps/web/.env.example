# URL publik Express API
NEXT_PUBLIC_API_URL=http://localhost:4000
# URL publik website ini (untuk sitemap, metadata, link bagikan)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth untuk login panel. Kosongkan untuk mode lokal (login pakai DEV_AUTH_TOKEN API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Harus sama dengan REVALIDATE_SECRET di API
REVALIDATE_SECRET=ganti-dengan-string-acak
