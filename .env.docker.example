# Salin menjadi .env (di folder yang sama dengan docker-compose.yml), lalu isi.

# Kata sandi database di dalam Docker. Ganti dengan string acak.
POSTGRES_PASSWORD=ganti-kata-sandi-database

# String acak, dipakai website & API untuk saling percaya saat memperbarui halaman.
REVALIDATE_SECRET=ganti-string-acak-panjang

# Alamat website yang dibuka di browser
SITE_URL=http://localhost:3000
WEB_PORT=3000

# --- Login panel (Supabase Auth) -------------------------------------------
# Supabase → Project Settings → API (atau "API Keys" / "Data API")
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# Opsional: hanya untuk fitur "Undang pegawai". Rahasiakan, jangan dibagikan.
SUPABASE_SERVICE_ROLE_KEY=
# Opsional: hanya untuk project lama yang memakai JWT secret (HS256).
SUPABASE_JWT_SECRET=
# Email pemilik. Saat pertama login, akun dengan email ini otomatis jadi pemilik.
OWNER_EMAIL=

# --- DANA Payment Gateway (opsional; kosong = tombol bayar DANA disembunyikan) ---
# Daftar sandbox: https://dashboard.dana.id -> Sandbox. Simpan nilai asli di env Vercel, jangan di git.
DANA_ENV=sandbox
DANA_PARTNER_ID=
DANA_MERCHANT_ID=
# private key RSA (PEM). Satu baris: ganti baris baru dengan \n
DANA_PRIVATE_KEY=
DANA_ORIGIN=https://agung-website.vercel.app
# hanya untuk production; di sandbox SDK memakai public key sandbox DANA bawaan
DANA_PUBLIC_KEY=
